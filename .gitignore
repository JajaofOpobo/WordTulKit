# .NET / VSTO / Office / editor artefacts
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.trx
*.coverage
*.coveragexml

# VSTO ClickOnce publish output (regenerated by Visual Studio)
publish/

# Build outputs
*.dll
*.pdb
*.exe
!scripts/**/*.ps1

# Word temporary / lock / recovery files (never commit these)
~$*.doc*
*.tmp
*.wbk
*.asd

# Synthetic regression fixtures ARE committed; real client documents are NOT.
# Keep all fixtures under tests/fixtures/ and never commit files containing
# real case, contract, or personal data.
!tests/fixtures/**/*.docx

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Secrets and credentials (never commit)
*.pfx
*.snk
appsettings.*.json
.env
.env.*
